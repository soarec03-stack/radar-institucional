<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Radar Institucional - Mercado Financeiro">

    <title>Radar Institucional</title>

    <link rel="stylesheet"
          href="css/style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header class="header">

        <div class="logo">

            <div class="logo-icon">
                RI
            </div>

            <div>
                <h1>RADAR INSTITUCIONAL</h1>

                <span>
                    Global Markets Intelligence
                </span>
            </div>

        </div>


        <div class="header-info">

            <div>
                <span class="label">
                    Atualização
                </span>

                <strong id="dataAtualizacao">
                    --
                </strong>
            </div>

            <div class="market-status">

                <span class="status-dot"></span>

                Mercado

                <strong>ATIVO</strong>

            </div>

        </div>

    </header>


    <!-- ================= NAV ================= -->

    <nav class="navbar">

        <a href="#overview">
            Overview
        </a>

        <a href="#macro">
            Macro
        </a>

        <a href="#winwdo">
            WIN / WDO
        </a>

        <a href="#power">
            Power / Data Center
        </a>

        <a href="#portfolio">
            Carteira
        </a>

        <a href="#penny">
            Penny Stocks
        </a>

        <a href="#recomendacoes">
            Recomendações
        </a>

    </nav>


    <main class="container">


        <!-- ================= MARKET OVERVIEW ================= -->

        <section id="overview">

            <div class="section-header">

                <div>

                    <span class="section-number">
                        01
                    </span>

                    <h2>
                        Market Overview
                    </h2>

                </div>

                <span class="badge bullish">
                    RISK ON
                </span>

            </div>


            <div class="cards-grid">

                <div class="metric-card">

                    <span>
                        IBOVESPA
                    </span>

                    <strong id="ibovespa">
                        --
                    </strong>

                    <small class="positive">
                        ▲ --
                    </small>

                </div>


                <div class="metric-card">

                    <span>
                        DÓLAR
                    </span>

                    <strong id="dolar">
                        --
                    </strong>

                    <small>
                        USD / BRL
                    </small>

                </div>


                <div class="metric-card">

                    <span>
                        S&P 500
                    </span>

                    <strong id="sp500">
                        --
                    </strong>

                    <small class="positive">
                        ▲ --
                    </small>

                </div>


                <div class="metric-card">

                    <span>
                        NASDAQ
                    </span>

                    <strong id="nasdaq">
                        --
                    </strong>

                    <small class="positive">
                        ▲ --
                    </small>

                </div>


                <div class="metric-card">

                    <span>
                        BRENT
                    </span>

                    <strong id="brent">
                        --
                    </strong>

                    <small>
                        USD
                    </small>

                </div>


                <div class="metric-card">

                    <span>
                        TREASURY 10Y
                    </span>

                    <strong id="treasury">
                        --
                    </strong>

                    <small>
                        Yield
                    </small>

                </div>

            </div>

        </section>


        <!-- ================= MACRO ================= -->

        <section id="macro">

            <div class="section-header">

                <div>

                    <span class="section-number">
                        02
                    </span>

                    <h2>
                        Radar Macro
                    </h2>

                </div>

            </div>


            <div class="table-container">

                <table>

                    <thead>

                        <tr>

                            <th>
                                Evento
                            </th>

                            <th>
                                Situação
                            </th>

                            <th>
                                Impacto
                            </th>

                            <th>
                                WIN
                            </th>

                            <th>
                                WDO
                            </th>

                            <th>
                                Sentimento
                            </th>

                        </tr>

                    </thead>

                    <tbody id="macroTable">

                    </tbody>

                </table>

            </div>

        </section>


        <!-- ================= WIN / WDO ================= -->

        <section id="winwdo">

            <div class="section-header">

                <div>

                    <span class="section-number">
                        03
                    </span>

                    <h2>
                        WIN / WDO — Operacional
                    </h2>

                </div>

            </div>


            <div class="two-columns">


                <div class="signal-card buy">

                    <div class="signal-header">

                        <span>
                            🟢 CENÁRIO A
                        </span>

                        <strong>
                            COMPRA WIN
                        </strong>

                    </div>

                    <ul>

                        <li>
                            WIN acima da VWAP
                        </li>

                        <li>
                            WDO abaixo da VWAP
                        </li>

                        <li>
                            DI perdendo força
                        </li>

                        <li>
                            Confirmação de volume
                        </li>

                    </ul>

                    <div class="confidence">

                        Confiança

                        <strong>
                            7.5 / 10
                        </strong>

                    </div>

                </div>


                <div class="signal-card sell">

                    <div class="signal-header">

                        <span>
                            🔴 CENÁRIO B
                        </span>

                        <strong>
                            VENDA WIN
                        </strong>

                    </div>

                    <ul>

                        <li>
                            WIN abaixo da VWAP
                        </li>

                        <li>
                            WDO rompendo máxima
                        </li>

                        <li>
                            DI subindo
                        </li>

                        <li>
                            Volume vendedor
                        </li>

                    </ul>

                    <div class="confidence">

                        Confiança

                        <strong>
                            8 / 10
                        </strong>

                    </div>

                </div>

            </div>

        </section>


        <!-- ================= POWER ================= -->

        <section id="power">

            <div class="section-header">

                <div>

                    <span class="section-number">
                        04
                    </span>

                    <h2>
                        ⚡ Power / Data Center Infrastructure
                    </h2>

                </div>

            </div>


            <div class="ranking-grid" id="powerGrid">

            </div>

        </section>


        <!-- ================= PORTFOLIO ================= -->

        <section id="portfolio">

            <div class="section-header">

                <div>

                    <span class="section-number">
                        05
                    </span>

                    <h2>
                        Minha Carteira
                    </h2>

                </div>

            </div>


            <div class="table-container">

                <table>

                    <thead>

                        <tr>

                            <th>
                                Ativo
                            </th>

                            <th>
                                Entrada
                            </th>

                            <th>
                                Preço
                            </th>

                            <th>
                                Target
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>

                    <tbody id="portfolioTable">

                    </tbody>

                </table>

            </div>

        </section>


        <!-- ================= PENNY STOCKS ================= -->

        <section id="penny">

            <div class="section-header">

                <div>

                    <span class="section-number">
                        06
                    </span>

                    <h2>
                        💰 Penny Stocks
                    </h2>

                </div>

            </div>


            <div class="ranking-grid"
                 id="pennyGrid">

            </div>

        </section>


        <!-- ================= RECOMMENDATIONS ================= -->

        <section id="recomendacoes">

            <div class="section-header">

                <div>

                    <span class="section-number">
                        07
                    </span>

                    <h2>
                        Radar de Recomendações
                    </h2>

                </div>

            </div>


            <div class="table-container">

                <table>

                    <thead>

                        <tr>

                            <th>
                                Rank
                            </th>

                            <th>
                                Ticker
                            </th>

                            <th>
                                Setor
                            </th>

                            <th>
                                Nota
                            </th>

                            <th>
                                Estratégia
                            </th>

                        </tr>

                    </thead>

                    <tbody id="recommendationTable">

                    </tbody>

                </table>

            </div>

        </section>


        <!-- ================= ALERT ================= -->

        <section class="alert-box">

            <div class="alert-icon">
                ⚠️
            </div>

            <div>

                <h3>
                    Próximo evento de alto impacto
                </h3>

                <p id="majorEvent">
                    --
                </p>

            </div>

        </section>


    </main>


    <!-- ================= FOOTER ================= -->

    <footer>

        <div>

            <strong>
                RADAR INSTITUCIONAL
            </strong>

            <p>
                Intelligence Dashboard
            </p>

        </div>

        <div>

            <p>
                Dados para fins informativos.
            </p>

            <p>
                © 2026 Radar Institucional
            </p>

        </div>

    </footer>


    <script src="js/radar.js"></script>

</body>

</html>