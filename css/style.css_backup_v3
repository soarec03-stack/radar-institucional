/* ============================================================
   RADAR INSTITUCIONAL — style.css
   Layout lateral / Dashboard
   Compatível com index.html V2.1
   ============================================================ */

:root {
    --bg: #07111f;
    --bg-soft: #0b1728;
    --panel: #0f1d30;
    --panel-2: #12233a;
    --panel-3: #162a45;

    --border: #223a58;
    --border-soft: #1a2f49;

    --text: #e8eef7;
    --text-soft: #9db0c7;
    --text-muted: #6f849d;

    --accent: #38bdf8;
    --accent-soft: rgba(56, 189, 248, 0.12);

    --positive: #22c55e;
    --negative: #ef4444;
    --warning: #f59e0b;

    --sidebar-width: 270px;
    --topbar-height: 78px;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
}


/* ============================================================
   RESET
   ============================================================ */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--topbar-height) + 24px);
}

body {
    margin: 0;
    min-height: 100vh;
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background:
        radial-gradient(
            circle at top right,
            rgba(56, 189, 248, 0.06),
            transparent 30%
        ),
        var(--bg);

    color: var(--text);
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select,
textarea {
    font: inherit;
}

table {
    border-collapse: collapse;
}

strong {
    font-weight: 700;
}


/* ============================================================
   APP SHELL
   ============================================================ */

.app-shell {
    display: flex;
    min-height: 100vh;
}

.app-content {
    min-width: 0;
    width: calc(100% - var(--sidebar-width));
    margin-left: var(--sidebar-width);
}


/* ============================================================
   SIDEBAR
   ============================================================ */

.sidebar {
    position: fixed;
    inset: 0 auto 0 0;

    width: var(--sidebar-width);
    height: 100vh;

    display: flex;
    flex-direction: column;

    background:
        linear-gradient(
            180deg,
            #0a1626 0%,
            #081320 100%
        );

    border-right: 1px solid var(--border-soft);

    z-index: 1000;
}

.sidebar-brand {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 22px 18px 20px;

    border-bottom: 1px solid var(--border-soft);
}

.logo-icon {
    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            var(--accent),
            #2563eb
        );

    color: #ffffff;

    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.06em;

    box-shadow:
        0 0 0 1px rgba(255,255,255,.06),
        0 8px 24px rgba(37, 99, 235, .25);
}

.sidebar-brand-text {
    min-width: 0;
}

.sidebar-brand-text h1 {
    margin: 0;

    font-size: 13px;
    line-height: 1.25;

    letter-spacing: 0.08em;
    font-weight: 800;
}

.sidebar-brand-text span {
    display: block;

    margin-top: 4px;

    color: var(--text-muted);

    font-size: 11px;
    line-height: 1.35;
}

.sidebar-nav {
    padding: 14px 10px;

    overflow-y: auto;

    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
}

.sidebar-nav::-webkit-scrollbar {
    width: 6px;
}

.sidebar-nav::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 999px;
}

.sidebar-link {
    display: flex;
    align-items: center;
    gap: 10px;

    min-height: 42px;

    padding: 9px 10px;

    border: 1px solid transparent;
    border-radius: 10px;

    color: var(--text-soft);

    font-size: 13px;
    font-weight: 600;

    transition:
        background .18s ease,
        color .18s ease,
        border-color .18s ease,
        transform .18s ease;
}

.sidebar-link:hover {
    background: rgba(56, 189, 248, .07);
    border-color: rgba(56, 189, 248, .14);

    color: #ffffff;

    transform: translateX(2px);
}

.sidebar-link.is-active {
    background:
        linear-gradient(
            90deg,
            rgba(56, 189, 248, .16),
            rgba(56, 189, 248, .06)
        );

    border-color: rgba(56, 189, 248, .22);

    color: #ffffff;
}

.sidebar-number {
    width: 26px;

    flex: 0 0 26px;

    color: var(--accent);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .05em;

    text-align: center;
}

.sidebar-meta {
    margin-top: auto;

    padding: 14px 18px 18px;

    display: grid;
    gap: 4px;

    border-top: 1px solid var(--border-soft);

    color: var(--text-muted);

    font-size: 10px;
}


/* ============================================================
   HEADER / TOP BAR
   ============================================================ */

.header {
    position: sticky;
    top: 0;

    min-height: var(--topbar-height);

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;

    padding: 14px 28px;

    background: rgba(7, 17, 31, .92);

    border-bottom: 1px solid var(--border-soft);

    backdrop-filter: blur(12px);

    z-index: 900;
}

.page-context {
    min-width: 0;
}

.page-context-label {
    display: block;

    color: var(--accent);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;

    text-transform: uppercase;
}

.page-context-title {
    display: block;

    margin-top: 3px;

    font-size: 15px;
    line-height: 1.2;
}

.header-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.header-info > div {
    min-width: 132px;

    padding: 8px 12px;

    background: rgba(15, 29, 48, .74);

    border: 1px solid var(--border-soft);
    border-radius: 10px;
}

.header-info .label {
    display: block;

    margin-bottom: 3px;

    color: var(--text-muted);

    font-size: 9px;
    font-weight: 700;
    letter-spacing: .08em;

    text-transform: uppercase;
}

.header-info strong {
    font-size: 12px;
}

.market-status {
    display: flex;
    align-items: center;
    gap: 7px;

    color: var(--text-soft);
    font-size: 11px;
}

.market-status strong {
    margin-left: auto;

    color: var(--text);
}

.status-dot {
    width: 8px;
    height: 8px;

    flex: 0 0 8px;

    border-radius: 50%;

    background: var(--text-muted);

    box-shadow: 0 0 0 4px rgba(148, 163, 184, .08);
}


/* ============================================================
   CONTENT
   ============================================================ */

.container {
    width: min(100%, 1680px);

    margin: 0 auto;

    padding: 26px 28px 42px;
}

section {
    margin-bottom: 28px;

    scroll-margin-top: calc(var(--topbar-height) + 18px);
}

.radar-pages {
    display: block;
}

/*
   Na Etapa 2 mantemos todas as páginas renderizadas.
   A navegação por página será controlada no radar.js na Etapa 3.
*/
.radar-page {
    display: block;
}


/* ============================================================
   SECTION HEADERS
   ============================================================ */

.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;

    margin-bottom: 14px;
}

.section-header > div:first-child {
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-header h2 {
    margin: 0;

    color: #ffffff;

    font-size: 18px;
    line-height: 1.25;
    font-weight: 750;
}

.section-number {
    min-width: 34px;
    height: 26px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 8px;

    border-radius: 8px;

    background: var(--accent-soft);
    border: 1px solid rgba(56, 189, 248, .18);

    color: var(--accent);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
}


/* ============================================================
   BADGES / STATES
   ============================================================ */

.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 26px;

    padding: 5px 9px;

    border-radius: 999px;

    background: rgba(148, 163, 184, .10);
    border: 1px solid rgba(148, 163, 184, .18);

    color: #cbd5e1;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
}

.bullish,
.positive {
    color: #7ee787 !important;
}

.badge.bullish,
.badge.positive {
    background: rgba(34, 197, 94, .10);
    border-color: rgba(34, 197, 94, .25);
}

.bearish {
    color: #ff8080 !important;
}

.badge.bearish {
    background: rgba(239, 68, 68, .10);
    border-color: rgba(239, 68, 68, .25);
}

.warning {
    color: #f6c453 !important;
}

.badge.warning {
    background: rgba(245, 158, 11, .10);
    border-color: rgba(245, 158, 11, .25);
}


/* ============================================================
   CARDS
   ============================================================ */

.cards-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 12px;
}

.metric-card,
.signal-card,
.ranking-card,
.alert-box {
    background:
        linear-gradient(
            180deg,
            rgba(18, 35, 58, .88),
            rgba(15, 29, 48, .88)
        );

    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.02);
}

.metric-card {
    min-height: 108px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 15px;
}

.metric-card span {
    color: var(--text-muted);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;

    text-transform: uppercase;
}

.metric-card strong {
    display: block;

    margin-top: 7px;

    color: #ffffff;

    font-size: 22px;
    line-height: 1.1;
}

.metric-card small {
    display: block;

    margin-top: 7px;

    color: var(--text-muted);

    font-size: 10px;
}

.two-columns {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 14px;

    margin-top: 14px;
}

.signal-card {
    padding: 16px;
}

.signal-card.buy {
    border-left: 3px solid rgba(34, 197, 94, .66);
}

.signal-card.sell {
    border-left: 3px solid rgba(239, 68, 68, .66);
}

.signal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    margin-bottom: 12px;

    color: var(--text-soft);

    font-size: 12px;
    font-weight: 700;
}

.signal-header strong {
    color: #ffffff;
}

.signal-card p {
    margin: 0;

    color: var(--text-soft);

    font-size: 12px;
    line-height: 1.65;
}

.signal-card ul {
    margin: 10px 0 0;
    padding-left: 18px;
}

.signal-card li {
    margin: 7px 0;

    color: var(--text-soft);

    font-size: 12px;
}

.confidence {
    display: flex;
    justify-content: space-between;
    gap: 12px;

    margin-top: 12px;
    padding-top: 10px;

    border-top: 1px solid var(--border-soft);

    color: var(--text-muted);

    font-size: 11px;
}

.confidence strong {
    color: var(--text);
}


/* ============================================================
   ALERT BOX
   ============================================================ */

.alert-box {
    display: flex;
    align-items: flex-start;
    gap: 14px;

    padding: 16px;

    margin-top: 14px;
}

.radar-summary-box {
    padding: 18px;
}

.alert-icon {
    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background: var(--accent-soft);
    border: 1px solid rgba(56, 189, 248, .18);

    color: var(--accent);

    font-size: 12px;
    font-weight: 800;
}

.alert-box h3 {
    margin: 0 0 7px;

    color: #ffffff;

    font-size: 14px;
}

.alert-box p {
    margin: 0;

    color: var(--text-soft);

    font-size: 12px;
    line-height: 1.65;
}

.alert-box p + p {
    margin-top: 9px;
}


/* ============================================================
   RANKING / DETAIL CARDS
   ============================================================ */

.ranking-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 12px;
}

.ranking-card {
    padding: 15px;
}

.ranking-card .rank {
    color: var(--accent);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
}

.ranking-card .ticker {
    margin-top: 5px;
    margin-bottom: 11px;

    color: #ffffff;

    font-size: 15px;
    font-weight: 750;
}

.ranking-card .strategy {
    margin-top: 7px;

    color: var(--text-soft);

    font-size: 11px;
    line-height: 1.55;
}

.ranking-card .strategy strong {
    color: #cbd8e8;
}


/* ============================================================
   TABLES
   ============================================================ */

.table-container {
    width: 100%;

    overflow-x: auto;

    background:
        linear-gradient(
            180deg,
            rgba(18, 35, 58, .82),
            rgba(15, 29, 48, .82)
        );

    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.02);
}

table {
    width: 100%;

    min-width: 760px;
}

thead {
    background: rgba(7, 17, 31, .44);
}

th {
    padding: 11px 12px;

    border-bottom: 1px solid var(--border-soft);

    color: #8ca2bb;

    font-size: 9px;
    font-weight: 800;
    letter-spacing: .07em;

    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
}

td {
    padding: 11px 12px;

    border-bottom: 1px solid rgba(34, 58, 88, .52);

    color: var(--text-soft);

    font-size: 11px;
    line-height: 1.45;

    vertical-align: middle;
}

tbody tr:last-child td {
    border-bottom: 0;
}

tbody tr {
    transition: background .16s ease;
}

tbody tr:hover {
    background: rgba(56, 189, 248, .035);
}

td strong {
    color: #ffffff;
}


/* ============================================================
   SUBSECTIONS
   ============================================================ */

section h3 {
    margin: 0 0 10px;

    color: #dce7f3;

    font-size: 13px;
    font-weight: 750;
}


/* ============================================================
   FOOTER
   ============================================================ */

footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;

    margin: 0 28px;
    padding: 18px 0 28px;

    border-top: 1px solid var(--border-soft);

    color: var(--text-muted);

    font-size: 10px;
}

footer strong {
    color: var(--text-soft);

    font-size: 11px;
}

footer p {
    margin: 3px 0 0;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1280px) {

    .cards-grid {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

    .ranking-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 1050px) {

    :root {
        --sidebar-width: 230px;
    }

    .container {
        padding-left: 20px;
        padding-right: 20px;
    }

    .header {
        padding-left: 20px;
        padding-right: 20px;
    }

    .cards-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .two-columns {
        grid-template-columns: 1fr;
    }

    footer {
        margin-left: 20px;
        margin-right: 20px;
    }
}

@media (max-width: 760px) {

    :root {
        --sidebar-width: 78px;
    }

    .sidebar-brand {
        justify-content: center;

        padding-left: 10px;
        padding-right: 10px;
    }

    .sidebar-brand-text,
    .sidebar-link > span:last-child,
    .sidebar-meta {
        display: none;
    }

    .sidebar-link {
        justify-content: center;
        padding-left: 8px;
        padding-right: 8px;
    }

    .sidebar-number {
        width: auto;
        flex-basis: auto;
    }

    .header {
        align-items: flex-start;
        flex-direction: column;

        min-height: auto;
    }

    .header-info {
        width: 100%;
    }

    .header-info > div {
        flex: 1;
        min-width: 0;
    }

    .cards-grid,
    .ranking-grid {
        grid-template-columns: 1fr;
    }

    .container {
        padding-top: 18px;
    }

    .section-header {
        align-items: flex-start;
    }

    footer {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 520px) {

    :root {
        --sidebar-width: 64px;
    }

    .logo-icon {
        width: 38px;
        height: 38px;

        flex-basis: 38px;
    }

    .container {
        padding-left: 14px;
        padding-right: 14px;
    }

    .header {
        padding-left: 14px;
        padding-right: 14px;
    }

    .header-info {
        flex-direction: column;
    }

    .header-info > div {
        width: 100%;
    }

    footer {
        margin-left: 14px;
        margin-right: 14px;
    }
}
/* ============================================================
   V2 — SIDEBAR VISUAL REFERENCE
   Ícones outline + item ativo azul
   ============================================================ */

.sidebar {
    background:
        linear-gradient(180deg, #07111f 0%, #08182a 100%);
    box-shadow: inset -1px 0 0 rgba(255,255,255,.02);
}

.sidebar-brand {
    padding: 28px 20px 24px;
    gap: 14px;
}

.logo-icon {
    width: 48px;
    height: 48px;
    flex-basis: 48px;
    border-radius: 10px;
    font-size: 17px;
    background: linear-gradient(135deg, #0ea5e9 0%, #075985 100%);
    box-shadow: 0 8px 28px rgba(14, 165, 233, .18);
}

.sidebar-brand-text h1 {
    font-size: 15px;
    line-height: 1.05;
    letter-spacing: .02em;
}

.sidebar-brand-text span {
    margin-top: 5px;
    font-size: 10px;
    color: #b7c6d8;
}

.sidebar-nav {
    padding: 16px 8px 20px;
}

.sidebar-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 46px;
    padding: 10px 14px;
    margin: 2px 0;
    border: 0;
    border-radius: 8px;
    color: #c4d3e5;
    font-size: 13px;
    font-weight: 500;
    transform: none;
}

.sidebar-link:hover {
    background: rgba(14, 165, 233, .08);
    border-color: transparent;
    transform: none;
}

.sidebar-link.is-active {
    background: linear-gradient(90deg, rgba(3,105,161,.92), rgba(3,105,161,.64));
    border-color: transparent;
    color: #ffffff;
    box-shadow:
        inset 3px 0 0 #22d3ee,
        0 8px 24px rgba(2, 132, 199, .16);
}

.sidebar-icon {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #d7e5f3;
}

.sidebar-link.is-active .sidebar-icon {
    color: #67e8f9;
}

.sidebar-icon svg,
.analysis-title-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.sidebar-label {
    min-width: 0;
    line-height: 1.2;
}

.sidebar-meta {
    padding: 18px 22px 22px;
    font-size: 10px;
    color: #91a4b8;
}

/* ============================================================
   ANALYSIS — EMPILHADO VERTICAL
   ============================================================ */

.analysis-stack {
    display: grid;
    grid-template-columns: 1fr;
    gap: 34px;
}

.analysis-block {
    min-width: 0;
}

.analysis-title-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin: 0 0 16px;
}

.analysis-title-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #67e8f9;
}

.analysis-title-row h3 {
    margin: 0;
    color: #ffffff;
    font-size: 17px;
    font-weight: 750;
}

.analysis-title-row p {
    margin: 4px 0 0;
    color: #9fb4ca;
    font-size: 12px;
    line-height: 1.5;
}

#analysis .table-container {
    overflow-x: auto;
}

#analysis table {
    min-width: 100%;
}

@media (max-width: 760px) {
    .sidebar-link {
        justify-content: center;
        padding-left: 10px;
        padding-right: 10px;
    }

    .sidebar-label {
        display: none;
    }

    .sidebar-icon {
        width: 24px;
        height: 24px;
        flex-basis: 24px;
    }
}
